# OpenOSINT — Environment Variables
# Copy this file to .env and fill in your keys
# Never commit .env to git

# AI backend — choose ONE of the following.

# ── 1) Anthropic Claude (default) ───────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional — override the default model. See https://platform.claude.com/docs/en/about-claude/models/migration-guide for current/deprecated model ids.
# ANTHROPIC_MODEL=
# OPENOSINT_MODEL is a deprecated alias for ANTHROPIC_MODEL — still works,
# but logs a one-time deprecation warning. Use ANTHROPIC_MODEL instead.

# ── 2) OpenAI hosted (api.openai.com) ───────────────────────────────────────
# Talk to OpenAI's own API. This provider defaults to a self-hosted gateway
# (see block 3 below) — without an explicit hosted base URL it will NOT
# reach OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── 3) Self-hosted OpenAI-compatible gateway (LiteLLM, llama-swap, vLLM, ───
#      LM Studio, llama.cpp, …). Takes precedence over Ollama when no
#      ANTHROPIC_API_KEY is set.  The model's server must support
#      tool/function calling (e.g. llama.cpp launched with --jinja).
# OPENAI_BASE_URL=http://localhost:4000/v1
# OPENAI_API_KEY=your_key_if_the_server_requires_one
# OPENAI_MODEL=gpt-4o-mini

# Optional — required to let POST /api/setup be called from a non-localhost
# caller (e.g. a public web deployment). Leave unset to keep /api/setup
# localhost-only. If set, remote callers must send it as X-Setup-Token.
# OPENOSINT_SETUP_TOKEN=

# Optional — explicit .env path, read by every entry point (CLI, web
# server, MCP server). The CLI and web server normally find their .env by
# searching upward from the current working directory, falling back to the
# repo root in a source/editable checkout. The MCP server checks those in
# the OPPOSITE order (repo root, then cwd search) because its host (Claude
# Desktop, etc.) launches it with an arbitrary cwd that has nothing to do
# with your .env — for MCP, set this explicitly instead of relying on
# either fallback (or a container mount that isn't the repo checkout):
#   OPENOSINT_ENV_FILE=/etc/openosint/.env
# A path that does not exist is a hard error (fails loudly), not a silent
# no-op.
# OPENOSINT_ENV_FILE=

# Optional — data breach checks
HIBP_API_KEY=your_key

# Optional — IP intelligence
IPINFO_TOKEN=your_token

# Sponsored — IP2Location Security Plan
IP2LOCATION_API_KEY=your_key

# Optional — VirusTotal
VIRUSTOTAL_API_KEY=your_key

# Optional — Shodan
SHODAN_API_KEY=your_key

# Optional — Censys
CENSYS_API_ID=your_id
CENSYS_SECRET=your_secret

# Optional — AbuseIPDB IP reputation
ABUSEIPDB_API_KEY=your_key

# Optional — GitHub profile/repo/email discovery (raises rate limit 60 → 5000 req/h)
GITHUB_TOKEN=your_token

# Optional — Bright Data (search_dorks_live + scrape_url tools)
# Free tier: 5,000 requests/month — https://get.brightdata.com/984ni58s2oad
# OpenOSINT earns a referral commission if you sign up through this link.
BRIGHTDATA_API_KEY=your_key
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1

# ── OpenOSINT Cloud (cloud/ gateway) ─────────────────────────────────────────
# Required for production; omit to run with the in-memory backend (tests only).

# Heroku Postgres — set automatically by: heroku addons:create heroku-postgresql
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Fernet key for encrypting customer BYOK secrets at rest.
# Required when DATABASE_URL is set.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

