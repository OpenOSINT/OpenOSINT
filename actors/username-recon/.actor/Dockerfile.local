FROM apify/actor-python:3.13

COPY requirements.txt ./

# Local-only override: build-local.sh drops the in-repo openosint wheel here
# (its pinned version isn't published yet, so pip would otherwise try to
# "upgrade" past the local wheel and hit PyPI). Never used by `apify push` /
# the Apify Cloud build — that path uses the plain Dockerfile in this
# directory, which only installs from requirements.txt.
COPY local-wheels/ /tmp/local-wheels/
RUN if ls /tmp/local-wheels/*.whl >/dev/null 2>&1; then \
        pip install --no-cache-dir /tmp/local-wheels/*.whl && \
        grep -v '^openosint' requirements.txt > requirements.txt.tmp && \
        mv requirements.txt.tmp requirements.txt; \
    fi

RUN echo "Python version:" \
    && python --version \
    && echo "Installing dependencies:" \
    && pip install -U pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt \
    && echo "All installed dependencies:" \
    && pip freeze

COPY . ./

CMD ["python", "-m", "src"]
