{
    "actorSpecification": 1,
    "fields": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
            "query": {
                "type": "string",
                "title": "Query",
                "description": "The search query this mention matched.",
                "example": "ukraine"
            },
            "locationName": {
                "type": "string",
                "title": "Location",
                "description": "Human-readable location name from GDELT.",
                "example": "Kyiv, Kyiv Misto, Ukraine"
            },
            "lat": {
                "type": "number",
                "title": "Latitude",
                "description": "Location latitude.",
                "example": 50.45
            },
            "lon": {
                "type": "number",
                "title": "Longitude",
                "description": "Location longitude.",
                "example": 30.52
            },
            "articleCount": {
                "type": ["integer", "null"],
                "title": "Article count",
                "description": "Number of matching articles GDELT associated with this location, when available.",
                "example": 12
            },
            "sampleUrls": {
                "type": "array",
                "title": "Sample article URLs",
                "description": "Up to 3 article URLs extracted from GDELT's popup data for this location.",
                "example": ["https://example-news.com/article-1"]
            },
            "timespanMinutes": {
                "type": "integer",
                "title": "Timespan (minutes)",
                "description": "The lookback window used for this search.",
                "example": 60
            },
            "checkedAt": {
                "type": "string",
                "title": "Checked at",
                "description": "ISO 8601 timestamp when this search was run.",
                "example": "2026-09-17T12:00:00Z"
            }
        },
        "required": ["query", "locationName", "lat", "lon", "checkedAt"]
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": ["locationName", "lat", "lon", "articleCount", "checkedAt"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "locationName": { "label": "Location" },
                    "lat": { "label": "Lat" },
                    "lon": { "label": "Lon" },
                    "articleCount": { "label": "Articles" },
                    "checkedAt": { "label": "Checked at" }
                }
            }
        }
    }
}
